#!/bin/sh
# Routes the traffic of ocserv clients out through the tunnel of another connected client.
#
# State file /etc/ocserv/exit-clients, one entry per line: "<key> <source ipv4> <exit client CN>".
# "sync" builds one routing table per entry: default via the tunnel device of the exit client while
# it is connected, otherwise "unreachable" (kill-switch: no leak through the default route).
# "watch" runs "sync" whenever a network link appears or disappears (a client connects/disconnects).

STATE=/etc/ocserv/exit-clients
PRIO=1500
TABLE_BASE=3000
COUNT=/var/run/ocserv-exit.count

sync_rules() {
	local prev=0 n=0 key ip cn dev users t

	[ -f "$COUNT" ] && prev=$(cat "$COUNT")

	while ip rule del prio $((PRIO - 1)) 2>/dev/null; do :; done
	while ip rule del prio "$PRIO" 2>/dev/null; do :; done

	users=$(/usr/bin/occtl --json show users 2>/dev/null)

	if [ -f "$STATE" ]; then
		while read -r key ip cn; do
			[ -n "$ip" ] && [ -n "$cn" ] || continue
			t=$((TABLE_BASE + n))
			n=$((n + 1))
			dev=$(jsonfilter -s "$users" -e "@[@.Username='$cn'].Device" 2>/dev/null | head -n1)

			ip route flush table "$t" 2>/dev/null
			if [ -n "$dev" ] && [ -d "/sys/class/net/$dev" ]; then
				# replies come back on the tunnel of the exit client from foreign sources
				sysctl -qw "net.ipv4.conf.$dev.rp_filter=0" 2>/dev/null
				ip route replace default dev "$dev" table "$t"
			else
				ip route replace unreachable default table "$t"
			fi
			# keep local, LAN and other client routes of the main table; only its default route is skipped
			ip rule add prio $((PRIO - 1)) from "$ip/32" lookup main suppress_prefixlength 0
			ip rule add prio "$PRIO" from "$ip/32" lookup "$t"
		done < "$STATE"
	fi

	# tables of entries that no longer exist
	t=$n
	while [ "$t" -lt "$prev" ]; do
		ip route flush table $((TABLE_BASE + t)) 2>/dev/null
		t=$((t + 1))
	done
	echo "$n" > "$COUNT"
}

watch_links() {
	sleep 3
	sync_rules
	ip monitor link 2>/dev/null | while read -r _; do
		# collect a burst of events, then let occtl register the session
		while read -t 2 -r _; do :; done
		sleep 1
		sync_rules
	done
}

case "$1" in
	sync) sync_rules ;;
	watch) watch_links ;;
	*) echo "usage: $0 sync|watch" >&2; exit 1 ;;
esac
